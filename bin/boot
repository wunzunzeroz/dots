#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'boot: %s\n' "$1" >&2
  exit 1
}

find_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not a git repository"
}

find_free_port() {
  local start="${1:-8081}"
  local max=$((start + 100))
  local port="$start"
  while [ "$port" -lt "$max" ]; do
    if ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
      echo "$port"
      return 0
    fi
    port=$((port + 1))
  done
  die "no free port in $start-$((max - 1))"
}

detect_pm() {
  local dir="$1"
  if [ -f "$dir/yarn.lock" ]; then
    echo yarn
  elif [ -f "$dir/pnpm-lock.yaml" ]; then
    echo pnpm
  elif [ -f "$dir/bun.lockb" ]; then
    echo bun
  elif [ -f "$dir/package-lock.json" ]; then
    echo npm
  else
    die "no lockfile in $dir; can't detect package manager"
  fi
}

pick_worktree() {
  command -v fzf >/dev/null || die "fzf not found. brew install fzf"
  local picker_cmd
  if [ -n "${TMUX:-}" ]; then
    picker_cmd=(fzf-tmux -p 80%,60% --with-nth=2,1 --delimiter=$'\t')
  else
    picker_cmd=(fzf --with-nth=2,1 --delimiter=$'\t')
  fi
  local selected
  selected="$("${picker_cmd[@]}" || true)"
  [ -n "$selected" ] || return 0
  printf '%s\n' "${selected%%$'\t'*}"
}

list_worktrees() {
  local path branch
  path=""
  branch=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*)
        if [ -n "$path" ]; then
          printf '%s\t%s\n' "$path" "${branch:-(detached)}"
        fi
        path="${line#worktree }"
        branch=""
        ;;
      "branch refs/heads/"*)
        branch="${line#branch refs/heads/}"
        ;;
      "detached")
        branch="(detached)"
        ;;
    esac
  done < <(git worktree list --porcelain)
  if [ -n "$path" ]; then
    printf '%s\t%s\n' "$path" "${branch:-(detached)}"
  fi
}

main() {
  find_repo_root >/dev/null
  local selected
  selected="$(list_worktrees | pick_worktree)"
  [ -n "$selected" ] || exit 0

  cd "$selected"

  local pm port
  pm="$(detect_pm "$selected")"
  port="$(find_free_port 8081)"

  printf 'boot: using %s at %s on port %s\n' "$pm" "$selected" "$port"

  "$pm" install

  export RCT_METRO_PORT="$port"
  export EXPO_PACKAGER_PORT="$port"
  exec "$pm" start --port "$port"
}

main "$@"
